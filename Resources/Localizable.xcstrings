    "TRENDING · SERIES": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TENDENCIA · SERIE"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "IM TREND · SERIE"
          }
        },
        "fr": {
          "stringUnit": {
