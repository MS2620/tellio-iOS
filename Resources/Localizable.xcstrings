    "Try MPEG-TS if channels fail on HLS. Stable switching starts slower but buffers more.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba MPEG-TS si los canales fallan con HLS. El cambio estable empieza más despacio pero almacena más."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche MPEG-TS, wenn Sender mit HLS nicht laufen. Stabiles Umschalten startet langsamer, puffert aber mehr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez MPEG-TS si les chaînes échouent en HLS. Le changement stable démarre plus lentement mais met davantage en mémoire tampon."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente MPEG-TS se os canais falharem em HLS. A troca estável começa mais devagar mas guarda mais em memória."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj MPEG-TS, jeśli kanały nie działają w HLS. Stabilne przełączanie startuje wolniej, ale buforuje więcej."
          }
        }
      }
    },
    "Try again": {
