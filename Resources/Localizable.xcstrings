    "Drag the handles to reorder. Continue Watching is always first. My List, Favourite Channels and My Teams only appear once they have something in them. The order is shared with the Apple TV.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra los tiradores para reordenar. Seguir viendo siempre va primero. Mi lista, Canales favoritos y Mis equipos solo aparecen cuando tienen algo. El orden se comparte con el Apple TV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe die Griffe zum Umsortieren. Weiterschauen ist immer zuerst. Meine Liste, Lieblingssender und Meine Teams erscheinen erst, wenn sie etwas enthalten. Die Reihenfolge wird mit dem Apple TV geteilt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser les poignées pour réorganiser. Reprendre est toujours en premier. Ma liste, Chaînes favorites et Mes équipes n'apparaissent que lorsqu'elles contiennent quelque chose. L'ordre est partagé avec l'Apple TV."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste as pegas para reordenar. Continuar a ver aparece sempre primeiro. Minha lista, Canais favoritos e As minhas equipas só aparecem quando têm algo. A ordem é partilhada com a Apple TV."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągaj uchwyty, aby zmienić kolejność. Oglądaj dalej jest zawsze pierwsze. Moja lista, Ulubione kanały i Moje drużyny pojawiają się dopiero, gdy coś zawierają. Kolejność jest wspólna z Apple TV."
          }
        }
      }
    },
    "Drag to reorder, swipe left to take a channel out.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar, desliza a la izquierda para quitar un canal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen zum Umsortieren, nach links wischen, um einen Sender zu entfernen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour réorganiser, balayez vers la gauche pour retirer une chaîne."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para reordenar, deslize para a esquerda para retirar um canal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, aby zmienić kolejność; przesuń w lewo, aby usunąć kanał."
          }
        }
      }
    },
