    "Free from themoviedb.org › Settings › API. Use the long \"API Read Access Token\", not the short API key.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis en themoviedb.org › Settings › API. Usa el «API Read Access Token» largo, no la clave API corta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlos unter themoviedb.org › Settings › API. Verwende das lange „API Read Access Token“, nicht den kurzen API-Schlüssel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit sur themoviedb.org › Settings › API. Utilisez le long « API Read Access Token », pas la clé API courte."
          }
