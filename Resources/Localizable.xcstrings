    "Some addons are locked by parental controls.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos addons están bloqueados por el control parental."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Add-ons sind durch die Kindersicherung gesperrt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains add-ons sont verrouillés par le contrôle parental."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns addons estão bloqueados pelo controlo parental."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre dodatki są zablokowane przez kontrolę rodzicielską."
          }
        }
      }
    },
    "Starting now": {
      "localizations": {
