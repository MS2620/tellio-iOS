    "Signs out of TMDB and your IPTV accounts and removes every addon. Your favourites, folders and other settings stay.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra sesión en TMDB y en tus cuentas IPTV y quita todos los addons. Tus favoritos, carpetas y demás ajustes se mantienen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldet dich bei TMDB und deinen IPTV-Konten ab und entfernt alle Add-ons. Deine Favoriten, Ordner und anderen Einstellungen bleiben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous déconnecte de TMDB et de vos comptes IPTV et supprime tous les add-ons. Vos favoris, dossiers et autres réglages sont conservés."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina sessão no TMDB e nas suas contas IPTV e remove todos os addons. Os seus favoritos, pastas e outras definições mantêm-se."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wylogowuje z TMDB i kont IPTV oraz usuwa wszystkie dodatki. Ulubione, foldery i pozostałe ustawienia zostają."
          }
        }
      }
    },
