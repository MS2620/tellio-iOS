            "value": "Twoje konto"
          }
        }
      }
    },
    "Your contact is only for a reply; it's kept private and never posted. Feedback never includes your logins, server or channel names.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu contacto solo sirve para responderte; se mantiene privado y nunca se publica. Los comentarios nunca incluyen tus accesos, tu servidor ni nombres de canales."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Kontaktangabe ist nur für eine Antwort; sie bleibt privat und wird nie veröffentlicht. Feedback enthält nie deine Zugangsdaten, deinen Server oder Sendernamen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre contact sert uniquement à vous répondre ; il reste privé et n'est jamais publié. Les retours n'incluent jamais vos identifiants, votre serveur ni les noms de chaînes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu contacto serve apenas para responder; é mantido privado e nunca é publicado. O feedback nunca inclui os seus acessos, servidor ou nomes de canais."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontakt służy tylko do odpowiedzi; pozostaje prywatny i nigdy nie jest publikowany. Opinie nigdy nie zawierają danych logowania, serwera ani nazw kanałów."
          }
        }
      }
    },
    "Your name is used everywhere and saved for this IPTV account.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nombre se usa en todas partes y se guarda para esta cuenta IPTV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Name wird überall verwendet und für dieses IPTV-Konto gespeichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre nom est utilisé partout et enregistré pour ce compte IPTV."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu nome é usado em todo o lado e guardado para esta conta IPTV."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja nazwa jest używana wszędzie i zapisana dla tego konta IPTV."
          }
        }
      }
    },
    "Your provider may only allow one stream at a time.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que tu proveedor solo permita una emisión a la vez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Anbieter erlaubt vielleicht nur einen Stream gleichzeitig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre fournisseur n'autorise peut-être qu'un flux à la fois."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu fornecedor pode permitir apenas uma emissão de cada vez."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój dostawca może pozwalać tylko na jeden strumień naraz."
          }
        }
      }
    },
