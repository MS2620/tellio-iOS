    "Swipe left on a team to stop following it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza a la izquierda sobre un equipo para dejar de seguirlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische auf einem Team nach links, um ihm nicht mehr zu folgen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez une équipe vers la gauche pour ne plus la suivre."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para a esquerda numa equipa para deixar de a seguir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń drużynę w lewo, aby przestać ją obserwować."
          }
        }
      }
    },
    "Switch a group off to hide it everywhere, or open it to hide single channels.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva un grupo para ocultarlo en todas partes, o ábrelo para ocultar canales sueltos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte eine Gruppe aus, um sie überall auszublenden, oder öffne sie, um einzelne Sender auszublenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez un groupe pour le masquer partout, ou ouvrez-le pour masquer des chaînes une par une."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative um grupo para o ocultar em todo o lado, ou abra-o para ocultar canais individuais."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącz grupę, aby ukryć ją wszędzie, albo otwórz ją, aby ukryć pojedyncze kanały."
          }
        }
      }
    },
    "Syncs when Tellio opens and every 10 minutes. Scrobbling shows “Watching now” on your Trakt profile and marks things watched at 80%.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sincroniza al abrir Tellio y cada 10 minutos. El scrobbling muestra «Viendo ahora» en tu perfil de Trakt y marca lo visto al 80 %."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisiert beim Öffnen von Tellio und alle 10 Minuten. Scrobbling zeigt „Schaut gerade“ in deinem Trakt-Profil und markiert Titel bei 80 % als gesehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se synchronise à l'ouverture de Tellio et toutes les 10 minutes. Le scrobbling affiche « En cours » sur votre profil Trakt et marque comme vu à 80 %."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza quando o Tellio abre e a cada 10 minutos. O scrobbling mostra «A ver agora» no seu perfil Trakt e marca como visto aos 80%."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizuje się przy otwarciu Tellio i co 10 minut. Scrobbling pokazuje „Teraz ogląda” na profilu Trakt i oznacza jako obejrzane przy 80%."
          }
        }
      }
    },
