    "Pause and rewind live TV": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar y rebobinar la TV en directo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-TV pausieren und zurückspulen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre en pause et revenir en arrière en direct"
          }
        },
        "pt-PT": {
