            "state": "translated",
            "value": "Odblokuj"
          }
        }
      }
    },
    "Use the manifest link from the addon's own configuration page. Only results with a direct link can be played; torrent-only results are hidden.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el enlace del manifiesto de la página de configuración del propio addon. Solo se pueden reproducir resultados con enlace directo; los que son solo torrent se ocultan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende den Manifest-Link von der Konfigurationsseite des Add-ons. Nur Ergebnisse mit direktem Link können abgespielt werden; reine Torrent-Ergebnisse werden ausgeblendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le lien du manifeste depuis la page de configuration de l'add-on. Seuls les résultats avec un lien direct peuvent être lus ; ceux uniquement en torrent sont masqués."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a ligação do manifesto da página de configuração do próprio addon. Só os resultados com ligação direta podem ser reproduzidos; os que são apenas torrent ficam ocultos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj linku do manifestu ze strony konfiguracji dodatku. Odtwarzać można tylko wyniki z bezpośrednim linkiem; wyniki tylko z torrentem są ukryte."
          }
        }
      }
    },
    "Using the built-in app": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usando la app integrada"
          }
        },
        "de": {
