    "Watch channel": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver canal"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender ansehen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarder la chaîne"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver canal"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oglądaj kanał"
          }
        }
      }
    },
    "When Tellio crashes, a report is sent the next time it opens. It holds where in Tellio's code it crashed and the iOS version and model, nothing else.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando Tellio falla, se envía un informe la próxima vez que se abre. Contiene en qué parte del código de Tellio falló, y la versión de iOS y el modelo, nada más."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Tellio abstürzt, wird beim nächsten Öffnen ein Bericht gesendet. Er enthält, wo im Code von Tellio es abgestürzt ist, sowie die iOS-Version und das Modell, sonst nichts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand Tellio plante, un rapport est envoyé à la prochaine ouverture. Il indique où le code de Tellio a planté, ainsi que la version d'iOS et le modèle, rien d'autre."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o Tellio falha, é enviado um relatório da próxima vez que abre. Indica onde no código do Tellio falhou, e a versão do iOS e o modelo, nada mais."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy Tellio się zawiesi, przy następnym otwarciu wysyłany jest raport. Zawiera miejsce w kodzie Tellio, w którym nastąpiła awaria, oraz wersję iOS i model, nic więcej."
          }
        }
      }
    },
    "When streams are sorted by addon order, addons higher in the list come first.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando las emisiones se ordenan por addon, los addons más arriba en la lista van primero."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Streams nach Add-on-Reihenfolge sortiert sind, kommen Add-ons weiter oben in der Liste zuerst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand les flux sont triés par add-on, les add-ons placés plus haut dans la liste passent en premier."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando as emissões são ordenadas por addon, os addons mais acima na lista aparecem primeiro."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy strumienie są sortowane według dodatków, dodatki wyżej na liście są pierwsze."
          }
        }
      }
    },
    "You stopped at %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te quedaste en %@"
          }
        },
