<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Tellio</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>

	<!-- Built-in keys. Left empty here; CI fills them from GitHub secrets with
	     Scripts/fill-secrets.sh. Empty means "enter your own" / feature off. -->
	<key>TraktClientID</key>
	<string></string>
	<key>TMDBToken</key>
	<string></string>
	<key>SentryDSN</key>
	<string></string>
	<key>FeedbackURL</key>
	<string></string>
	<key>LibraryVersions</key>
	<string></string>

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Many playlists only serve plain http -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.mauro.tellio</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tellio</string>
			</array>
		</dict>
	</array>
	<!-- Portrait for browsing, landscape for the player -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Keeps sound going in picture in picture and over AirPlay -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
</dict>
</plist>
